{
  "name": "kidastro-themes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A personal gallery of hand-tuned UI themes — token-driven React + Tailwind components you can point AI tools at to bootstrap prototypes.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/spa-fallback.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "guard": "node scripts/check-tokens.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "check": "npm run typecheck && npm run lint && npm run guard && npm run contrast && npm run build"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.0.7"
  }
}
